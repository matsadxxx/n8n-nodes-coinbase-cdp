{
  "name": "Coinbase CDP - Account & Balance Check",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "resource": "account",
        "operation": "getOrCreate",
        "accountName": "my-wallet"
      },
      "id": "create-account",
      "name": "Get or Create Account",
      "type": "CUSTOM.coinbaseCdp",
      "typeVersion": 1,
      "position": [480, 300],
      "credentials": {
        "coinbaseCdpApi": {
          "id": "1",
          "name": "Coinbase CDP API"
        }
      }
    },
    {
      "parameters": {
        "resource": "balance",
        "operation": "listTokens",
        "address": "={{ $json.address }}",
        "network": "base-sepolia"
      },
      "id": "check-balance",
      "name": "Check Balance",
      "type": "CUSTOM.coinbaseCdp",
      "typeVersion": 1,
      "position": [720, 300],
      "credentials": {
        "coinbaseCdpApi": {
          "id": "1",
          "name": "Coinbase CDP API"
        }
      }
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [[{ "node": "Get or Create Account", "type": "main", "index": 0 }]]
    },
    "Get or Create Account": {
      "main": [[{ "node": "Check Balance", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
