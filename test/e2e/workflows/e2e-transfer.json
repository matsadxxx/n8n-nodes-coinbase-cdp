{
  "name": "E2E: Transfer Assertions",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "resource": "account",
        "operation": "getOrCreate",
        "accountName": "e2e-xfer-sender"
      },
      "id": "create-sender",
      "name": "Create Sender",
      "type": "CUSTOM.coinbaseCdp",
      "typeVersion": 1,
      "position": [480, 300],
      "credentials": {
        "coinbaseCdpApi": { "id": "1", "name": "Coinbase CDP API" }
      }
    },
    {
      "parameters": {
        "resource": "account",
        "operation": "getOrCreate",
        "accountName": "e2e-xfer-receiver"
      },
      "id": "create-receiver",
      "name": "Create Receiver",
      "type": "CUSTOM.coinbaseCdp",
      "typeVersion": 1,
      "position": [720, 300],
      "credentials": {
        "coinbaseCdpApi": { "id": "1", "name": "Coinbase CDP API" }
      }
    },
    {
      "parameters": {
        "resource": "account",
        "operation": "requestFaucet",
        "address": "={{ $('Create Sender').item.json.address }}",
        "faucetNetwork": "base-sepolia",
        "faucetToken": "eth"
      },
      "id": "fund-eth",
      "name": "Fund ETH",
      "type": "CUSTOM.coinbaseCdp",
      "typeVersion": 1,
      "position": [960, 300],
      "credentials": {
        "coinbaseCdpApi": { "id": "1", "name": "Coinbase CDP API" }
      }
    },
    {
      "parameters": {
        "resource": "account",
        "operation": "requestFaucet",
        "address": "={{ $('Create Sender').item.json.address }}",
        "faucetNetwork": "base-sepolia",
        "faucetToken": "usdc"
      },
      "id": "fund-usdc",
      "name": "Fund USDC",
      "type": "CUSTOM.coinbaseCdp",
      "typeVersion": 1,
      "position": [1200, 300],
      "credentials": {
        "coinbaseCdpApi": { "id": "1", "name": "Coinbase CDP API" }
      }
    },
    {
      "parameters": {
        "resource": "transfer",
        "operation": "sendNative",
        "accountName": "e2e-xfer-sender",
        "to": "={{ $('Create Receiver').item.json.address }}",
        "amount": "0.0001",
        "network": "base-sepolia"
      },
      "id": "send-native",
      "name": "Send Native",
      "type": "CUSTOM.coinbaseCdp",
      "typeVersion": 1,
      "position": [1440, 300],
      "credentials": {
        "coinbaseCdpApi": { "id": "1", "name": "Coinbase CDP API" }
      }
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.transactionHash }}",
              "operation": "startsWith",
              "value2": "0x"
            },
            {
              "value1": "={{ $json.from }}",
              "operation": "startsWith",
              "value2": "0x"
            }
          ]
        }
      },
      "id": "assert-native",
      "name": "Assert Native",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1680, 300]
    },
    {
      "parameters": {
        "errorMessage": "transfer>sendNative: transactionHash or from does not start with 0x"
      },
      "id": "fail-native",
      "name": "Fail: Native",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [1680, 500]
    },
    {
      "parameters": {
        "resource": "transfer",
        "operation": "sendErc20",
        "accountName": "e2e-xfer-sender",
        "to": "={{ $('Create Receiver').item.json.address }}",
        "amount": "1000",
        "token": "usdc",
        "network": "base-sepolia"
      },
      "id": "send-erc20",
      "name": "Send ERC20",
      "type": "CUSTOM.coinbaseCdp",
      "typeVersion": 1,
      "position": [1920, 300],
      "credentials": {
        "coinbaseCdpApi": { "id": "1", "name": "Coinbase CDP API" }
      }
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.transactionHash }}",
              "operation": "startsWith",
              "value2": "0x"
            }
          ]
        }
      },
      "id": "assert-erc20",
      "name": "Assert ERC20",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [2160, 300]
    },
    {
      "parameters": {
        "errorMessage": "transfer>sendErc20: transactionHash does not start with 0x"
      },
      "id": "fail-erc20",
      "name": "Fail: ERC20",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [2160, 500]
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [[{ "node": "Create Sender", "type": "main", "index": 0 }]]
    },
    "Create Sender": {
      "main": [[{ "node": "Create Receiver", "type": "main", "index": 0 }]]
    },
    "Create Receiver": {
      "main": [[{ "node": "Fund ETH", "type": "main", "index": 0 }]]
    },
    "Fund ETH": {
      "main": [[{ "node": "Fund USDC", "type": "main", "index": 0 }]]
    },
    "Fund USDC": {
      "main": [[{ "node": "Send Native", "type": "main", "index": 0 }]]
    },
    "Send Native": {
      "main": [[{ "node": "Assert Native", "type": "main", "index": 0 }]]
    },
    "Assert Native": {
      "main": [
        [{ "node": "Send ERC20", "type": "main", "index": 0 }],
        [{ "node": "Fail: Native", "type": "main", "index": 0 }]
      ]
    },
    "Send ERC20": {
      "main": [[{ "node": "Assert ERC20", "type": "main", "index": 0 }]]
    },
    "Assert ERC20": {
      "main": [
        [],
        [{ "node": "Fail: ERC20", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "executionOrder": "v1" }
}
