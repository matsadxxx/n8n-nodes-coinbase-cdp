{
  "name": "E2E: EVM Account & Balance Assertions",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "resource": "account",
        "operation": "getOrCreate",
        "accountName": "e2e-evm-acct"
      },
      "id": "get-or-create-acct",
      "name": "Get or Create Account",
      "type": "CUSTOM.coinbaseCdp",
      "typeVersion": 1,
      "position": [480, 300],
      "credentials": {
        "coinbaseCdpApi": { "id": "1", "name": "Coinbase CDP API" }
      }
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.address }}",
              "operation": "startsWith",
              "value2": "0x"
            }
          ]
        }
      },
      "id": "assert-account",
      "name": "Assert Account",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [720, 300]
    },
    {
      "parameters": {
        "errorMessage": "account>getOrCreate: address must start with 0x"
      },
      "id": "fail-account",
      "name": "Fail: Account",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [720, 500]
    },
    {
      "parameters": {
        "resource": "account",
        "operation": "listBalances",
        "address": "={{ $('Get or Create Account').item.json.address }}",
        "network": "base-sepolia"
      },
      "id": "list-balances",
      "name": "List Balances",
      "type": "CUSTOM.coinbaseCdp",
      "typeVersion": 1,
      "position": [960, 300],
      "credentials": {
        "coinbaseCdpApi": { "id": "1", "name": "Coinbase CDP API" }
      }
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.network }}",
              "operation": "equal",
              "value2": "base-sepolia"
            }
          ]
        }
      },
      "id": "assert-balances",
      "name": "Assert Balances",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1200, 300]
    },
    {
      "parameters": {
        "errorMessage": "account>listBalances: network mismatch, expected base-sepolia"
      },
      "id": "fail-balances",
      "name": "Fail: Balances",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [1200, 500]
    },
    {
      "parameters": {
        "resource": "balance",
        "operation": "listTokens",
        "address": "={{ $('Get or Create Account').item.json.address }}",
        "network": "base-sepolia"
      },
      "id": "list-tokens",
      "name": "List Tokens",
      "type": "CUSTOM.coinbaseCdp",
      "typeVersion": 1,
      "position": [1440, 300],
      "credentials": {
        "coinbaseCdpApi": { "id": "1", "name": "Coinbase CDP API" }
      }
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.network }}",
              "operation": "equal",
              "value2": "base-sepolia"
            }
          ]
        }
      },
      "id": "assert-tokens",
      "name": "Assert Tokens",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1680, 300]
    },
    {
      "parameters": {
        "errorMessage": "balance>listTokens: network mismatch, expected base-sepolia"
      },
      "id": "fail-tokens",
      "name": "Fail: Tokens",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [1680, 500]
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [[{ "node": "Get or Create Account", "type": "main", "index": 0 }]]
    },
    "Get or Create Account": {
      "main": [[{ "node": "Assert Account", "type": "main", "index": 0 }]]
    },
    "Assert Account": {
      "main": [
        [{ "node": "List Balances", "type": "main", "index": 0 }],
        [{ "node": "Fail: Account", "type": "main", "index": 0 }]
      ]
    },
    "List Balances": {
      "main": [[{ "node": "Assert Balances", "type": "main", "index": 0 }]]
    },
    "Assert Balances": {
      "main": [
        [{ "node": "List Tokens", "type": "main", "index": 0 }],
        [{ "node": "Fail: Balances", "type": "main", "index": 0 }]
      ]
    },
    "List Tokens": {
      "main": [[{ "node": "Assert Tokens", "type": "main", "index": 0 }]]
    },
    "Assert Tokens": {
      "main": [
        [],
        [{ "node": "Fail: Tokens", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "executionOrder": "v1" }
}
