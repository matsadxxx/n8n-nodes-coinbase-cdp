{
  "name": "E2E: Faucet Assertions",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "resource": "account",
        "operation": "getOrCreate",
        "accountName": "e2e-faucet-evm"
      },
      "id": "create-evm",
      "name": "Create EVM Account",
      "type": "CUSTOM.coinbaseCdp",
      "typeVersion": 1,
      "position": [480, 300],
      "credentials": {
        "coinbaseCdpApi": { "id": "1", "name": "Coinbase CDP API" }
      }
    },
    {
      "parameters": {
        "resource": "account",
        "operation": "requestFaucet",
        "address": "={{ $('Create EVM Account').item.json.address }}",
        "faucetNetwork": "base-sepolia",
        "faucetToken": "eth"
      },
      "id": "faucet-eth",
      "name": "Request ETH Faucet",
      "type": "CUSTOM.coinbaseCdp",
      "typeVersion": 1,
      "position": [720, 300],
      "credentials": {
        "coinbaseCdpApi": { "id": "1", "name": "Coinbase CDP API" }
      }
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.transactionHash }}",
              "operation": "startsWith",
              "value2": "0x"
            }
          ]
        }
      },
      "id": "assert-eth-faucet",
      "name": "Assert ETH Faucet",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [960, 300]
    },
    {
      "parameters": {
        "errorMessage": "account>requestFaucet: transactionHash does not start with 0x"
      },
      "id": "fail-eth-faucet",
      "name": "Fail: ETH Faucet",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [960, 500]
    },
    {
      "parameters": {
        "resource": "solanaAccount",
        "operation": "getOrCreate",
        "accountName": "e2e-faucet-sol"
      },
      "id": "create-solana",
      "name": "Create Solana Account",
      "type": "CUSTOM.coinbaseCdp",
      "typeVersion": 1,
      "position": [1200, 300],
      "credentials": {
        "coinbaseCdpApi": { "id": "1", "name": "Coinbase CDP API" }
      }
    },
    {
      "parameters": {
        "resource": "solanaAccount",
        "operation": "requestFaucet",
        "address": "={{ $('Create Solana Account').item.json.address }}",
        "faucetToken": "sol"
      },
      "id": "faucet-sol",
      "name": "Request SOL Faucet",
      "type": "CUSTOM.coinbaseCdp",
      "typeVersion": 1,
      "position": [1440, 300],
      "credentials": {
        "coinbaseCdpApi": { "id": "1", "name": "Coinbase CDP API" }
      }
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.signature }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "id": "assert-sol-faucet",
      "name": "Assert SOL Faucet",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1680, 300]
    },
    {
      "parameters": {
        "errorMessage": "solanaAccount>requestFaucet: signature is empty"
      },
      "id": "fail-sol-faucet",
      "name": "Fail: SOL Faucet",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [1680, 500]
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [[{ "node": "Create EVM Account", "type": "main", "index": 0 }]]
    },
    "Create EVM Account": {
      "main": [[{ "node": "Request ETH Faucet", "type": "main", "index": 0 }]]
    },
    "Request ETH Faucet": {
      "main": [[{ "node": "Assert ETH Faucet", "type": "main", "index": 0 }]]
    },
    "Assert ETH Faucet": {
      "main": [
        [{ "node": "Create Solana Account", "type": "main", "index": 0 }],
        [{ "node": "Fail: ETH Faucet", "type": "main", "index": 0 }]
      ]
    },
    "Create Solana Account": {
      "main": [[{ "node": "Request SOL Faucet", "type": "main", "index": 0 }]]
    },
    "Request SOL Faucet": {
      "main": [[{ "node": "Assert SOL Faucet", "type": "main", "index": 0 }]]
    },
    "Assert SOL Faucet": {
      "main": [
        [],
        [{ "node": "Fail: SOL Faucet", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "executionOrder": "v1" }
}
